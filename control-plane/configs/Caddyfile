{
    on_demand_tls {
        ask https://mock.httpstatus.io/200
    }

    log console {
        output stdout
        format console
        include http.log.access
    }
}


(stepca_acme) {
    issuer acme {
        dir https://localhost:9000/acme/acme/directory
        email sairam278.suresh@gmail.com
        disable_tlsalpn_challenge
        trusted_roots /home/step/certs/root_ca.crt
    }
}

coder.service.internal:443, *.coder.service.internal:443 {
    tls {
        on_demand
        import stepca_acme
    }

    log

    reverse_proxy http://100.96.35.98:7080
}

dns.service.internal:443 {
    tls {
        import stepca_acme
    }

    log

    reverse_proxy http://127.0.0.1:8080
}

admin.sairamsuresh.is-a.dev:443 {
    tls {
