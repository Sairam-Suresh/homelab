stepca.service.internal:80 {
    log

    @roots path /roots.pem
    @ints path /intermediates.pem

    respond / "OK" 200

    reverse_proxy @roots https://127.0.0.1:9000 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }
    reverse_proxy @ints https://127.0.0.1:9000 {
        transport http {
            tls
            tls_insecure_skip_verify
        }
    }

    handle {
        respond 404
    }
}