(stepca_acme) {
    issuer acme {
        dir https://localhost:9000/acme/acme/directory
        email sairam278.suresh@gmail.com
        disable_tlsalpn_challenge
        trusted_roots /home/step/certs/root_ca.crt
    }
}

coder.service.internal:443, *.coder.service.internal:443 {
    tls {
        on_demand
        import stepca_acme
    }

    # 1. Stream real-time JSON access logs to SparkPlug socket for idle & error tracking
    log {
        output net unix//var/run/caddy/sparkplug.sock
        format json
    }

    # 2. Proxy to upstream host with dial timeout for fast offline detection
    reverse_proxy {$CODER_UPSTREAM_IP} {
        transport http {
            dial_timeout 3s
        }
    }

    # 3. Intercept offline/sleeping errors and show SparkPlug wake screen
    handle_errors 502 503 504 {
        redir https://sparkplug.service.internal/wake/coder?redirect=https://{host}{uri} 307
    }
}

dns.service.internal:443 {
    tls {
        import stepca_acme
    }

    forward_auth 127.0.0.1:3000 {
        uri /api/authz/forward-auth
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }

    log

    reverse_proxy http://127.0.0.1:8080
}

